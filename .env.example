# Copia este fichero a ".env" y pega tu clave de Google AI Studio.
# Consíguela gratis en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=pega_aqui_tu_clave

# Modelo a usar. Si te da error de "modelo no encontrado", ejecuta
# el script "listar_modelos.py" para ver los disponibles con tu clave.
GEMINI_MODEL=models/gemini-2.0-flash
GEMINI_EMBED_MODEL=models/text-embedding-004
